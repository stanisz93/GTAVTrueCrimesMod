{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "validate missions",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\tools\\validate-missions.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "build code",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        ".\\GTAVTrueCrimesMod.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test logic",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        ".\\tests\\GTAVTrueCrimesMod.Tests.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test voice tools",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\tools\\test-voice-generation.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "deploy missions",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\tools\\deploy-missions.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "generate ElevenLabs Player voice",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\tools\\generate-elevenlabs-voice.ps1",
        "-ConfigFile",
        ".\\tools\\player_voice_generator_config.json"
      ],
      "problemMatcher": []
    },    
    {
      "label": "generate ElevenLabs Morgan voice",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\tools\\generate-elevenlabs-voice.ps1",
        "-ConfigFile",
        ".\\tools\\morgan_voice_generator_config.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "generate ElevenLabs Policeman voice",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\tools\\generate-elevenlabs-voice.ps1",
        "-ConfigFile",
        ".\\tools\\officer_voice_generator_config.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "convert VTT Officer conversation subtitles",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\tools\\convert-vtt-subtitles.ps1",
        "-AudioFolder",
        ".\\audio\\01_policeman_conv_police_station",
        "-OutputFolder",
        ".\\missions\\subtitles\\01_policeman_conv_police_station"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "dependsOrder": "sequence",
      "dependsOn": [
        "validate missions",
        "test logic",
        "test voice tools",
        "build code",
        "deploy missions"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
