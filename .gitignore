# Ignore everything in GTA root
/*

# Allow Git ignore file
!/.gitignore
!/README.md
!/LICENSE
!/ASSET_LICENSE.md
!/GTAVTrueCrimesMod.csproj
!/.vscode/
!/.vscode/tasks.json
!/tools/
!/tools/**
/tools/voice_generator_config.json
!/docs/
/docs/*
!/docs/voice-generation.md
!/src/
!/src/**
!/tests/
!/tests/**
/tests/bin/
/tests/obj/

# Allow scripts and missions folders
!/scripts/
!/missions/

# Allow all files inside scripts and missions
!/scripts/**
!/missions/**

# But ignore unwanted files inside them
/scripts/**/*.log
/missions/**/*.log
/scripts/**/*.tmp
/missions/**/*.tmp
/missions/subtitles/*.node-snippet.json

# Keep audio out for now
/build-check/
/scripts/**/*.mp3
/scripts/**/*.wav
/scripts/**/*.ogg
/missions/**/*.mp3
/missions/**/*.wav
/missions/**/*.ogg
